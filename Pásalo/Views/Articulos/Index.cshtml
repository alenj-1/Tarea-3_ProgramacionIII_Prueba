@model IEnumerable<Pásalo.Models.Articulo>

@{
    ViewData["Title"] = "Donaciones";
}

<h1>Donaciones</h1>

<p>Explora los artículos que otras personas tienen para donar.</p>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="mb-4">
    <a asp-action="Create" class="btn btn-primary">
        Donar un artículo
    </a>
</div>

<form asp-action="Index" method="get" class="panel mb-4">
    <div class="mb-3">
        <label for="busqueda" class="form-label">Buscar artículo</label>
        <input type="search" id="busqueda" name="busqueda" class="form-control" value="@ViewData["Busqueda"]" placeholder="Escribe el nombre de un artículo..." />
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label for="categoria" class="form-label">Categoría</label>
            <select id="categoria" name="categoria" class="form-select">
                <option value="">Todas</option>
                @foreach (var categoria in Pásalo.Models.OpcionesArticulo.Categorias)
                {
                    <option value="@categoria" selected="@(ViewData["Categoria"] as string == categoria)">
                        @categoria
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label for="condicion" class="form-label">Condición</label>
            <select id="condicion" name="condicion" class="form-select">
                <option value="">Todas</option>
                @foreach (var condicion in Pásalo.Models.OpcionesArticulo.Condiciones)
                {
                    <option value="@condicion" selected="@(ViewData["Condicion"] as string == condicion)">
                        @condicion
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label for="disponible" class="form-label">Disponibilidad</label>
            <select id="disponible" name="disponible" class="form-select">
                <option value="">Todas</option>
                <option value="true" selected="@((bool?)ViewData["Disponible"] == true)">
                    Disponible
                </option>

                <option value="false" selected="@((bool?)ViewData["Disponible"] == false)">
                    Donado
                </option>
            </select>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-secondary">
            Buscar
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Limpiar filtros
        </a>
    </div>
</form>

@if (!Model.Any())
{
    if (ViewData["HayDonaciones"] is true)
    {
        <div class="alert alert-info" role="alert">
            No se encontraron donaciones que coincidan con tu búsqueda.
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Aún no hay donaciones registradas.
        </div>
    }
}
else
{
    <div class="table-responsive tabla-contenedor">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col">Artículo</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Condición</th>
                    <th scope="col">Ubicación</th>
                    <th scope="col">Disponibilidad</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var articulo in Model)
                {
                    <tr>
                        <td>@articulo.Nombre</td>
                        <td>@articulo.Categoria</td>
                        <td>@articulo.Condicion</td>
                        <td>@articulo.Ubicacion</td>

                        <td>
                            @if (articulo.Disponible)
                            {
                                <span class="badge bg-success">
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Donado
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details" asp-route-id="@articulo.Id" class="btn btn-secondary btn-sm">
                                    Ver detalles
                                </a>

                                <a asp-action="Edit" asp-route-id="@articulo.Id" class="btn btn-outline-secondary btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Delete" asp-route-id="@articulo.Id" class="btn btn-outline-danger btn-sm">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}