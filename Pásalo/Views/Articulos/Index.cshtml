@model IEnumerable<Pásalo.Models.Articulo>

@{
    ViewData["Title"] = "Artículos";
}

<h1>Donaciones</h1>

<p>Descubre lo que otras personas tienen para compartir y encuentra lo que necesitas.</p>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="mb-4">
    <a asp-action="Create" class="btn btn-primary">
        Donar un artículo
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Aún no hay donaciones registradas.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Artículo</th>
                <th>Categoría</th>
                <th>Condición</th>
                <th>Ubicación</th>
                <th>Disponibilidad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var articulo in Model)
            {
                <tr>
                    <td>@articulo.Nombre</td>
                    <td>@articulo.Categoria</td>
                    <td>@articulo.Condicion</td>
                    <td>@articulo.Ubicacion</td>
                    <td>
                        @if (articulo.Disponible)
                        {
                            <span class="badge bg-success">
                                Disponible
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Donado
                            </span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@articulo.Id" class="btn btn-primary btn-sm">
                            Ver detalles
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}