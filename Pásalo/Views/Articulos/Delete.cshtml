@model Pásalo.Models.Articulo

@{
    ViewData["Title"] = "Eliminar donación";
}

<h1>Eliminar donación</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Artículo</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@Model.Categoria</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Condición</dt>
    <dd class="col-sm-9">@Model.Condicion</dd>

    <dt class="col-sm-3">Ubicación</dt>
    <dd class="col-sm-9">@Model.Ubicacion</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>

    <dt class="col-sm-3">Disponibilidad</dt>
    <dd class="col-sm-9">
        @if (Model.Disponible)
        {
            <span class="badge bg-success">Disponible</span>
        }
        else
        {
            <span class="badge bg-secondary">Donado</span>
        }
    </dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este artículo?\n\nEsta acción no se puede deshacer.');">
    <button type="submit" class="btn btn-danger">
        Eliminar donación
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver al listado
    </a>
</form>